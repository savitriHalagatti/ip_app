{
  "name": "ip-app-nodejs",
  "version": "1.0.0",
  "private": true,
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "lint": "eslint .",
    "test": "jest tests/unit",
    "test:ci": "jest tests/unit --ci --coverage --reporters=default --reporters=jest-junit",
    "test:integration": "jest tests/integration --ci --reporters=default --reporters=jest-junit"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "jest-junit": "17.0.0",
    "supertest": "7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["app.js"],
    "coverageDirectory": "reports/coverage",
    "coverageReporters": ["text", "html", "cobertura"],
    "coverageThreshold": {
      "global": { "lines": 80 }
    }
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "unit-tests.xml"
  }
}
